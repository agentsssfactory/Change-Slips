# --- required on Vercel (Settings → Environment Variables) ---
# Any long random text (e.g. run: openssl rand -hex 32)
JWT_SECRET=intelligenz it
ADMIN_EMAIL=agentsssfactory@gmail.com
# Local default below. Use a strong password on Vercel.
ADMIN_PASSWORD=12345
# DATABASE_URL is added automatically when you connect a Neon Postgres database in Vercel.
# Leave it empty locally: the app uses an embedded Postgres in ./data/pglite.
DATABASE_URL=

# --- optional ---
BUSINESS_NAME=ChangeSlip
DEFAULT_CURRENCY=USD
PORT=4000
# Local: demo users (demo@changeslip.com, demo2@changeslip.com / demo123) with sample slips unless SEED_DEMO=0.
# Vercel: no demo users unless SEED_DEMO=1.
SEED_DEMO=1
